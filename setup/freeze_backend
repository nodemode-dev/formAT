#!/usr/bin/env bash
set -e
source "$(dirname "$0")/lib.sh"
ft_rust_env
py="$(ft_venv_python)"
"$py" -c "import PyInstaller" 2>/dev/null || ft_die "PyInstaller is missing; from the Format folder run ./build_app, which installs it"
triple="$(ft_target_triple)" || ft_die "rustc not found; install Rust or set FORMAT_TARGET"
[ -f "$FORMAT_ROOT/frontend/dist/index.html" ] || "$FORMAT_ROOT/setup/build_frontend"
cd "$FORMAT_ROOT/backend"
optional=()
ft_has playwright && optional+=(--collect-all playwright)
if ft_has faster_whisper; then
  "$py" "$FORMAT_ROOT/setup/check_lgpl_av.py" "${LGPL_FFMPEG_PREFIX:-$FORMAT_ROOT/backend/.lgpl-ffmpeg}" || ft_die "voice needs PyAV built against an LGPL FFmpeg; run setup/build_lgpl_av"
  optional+=(--collect-all faster_whisper --collect-all ctranslate2 --collect-all onnxruntime --collect-all tokenizers)
fi
ft_has ptyprocess && optional+=(--collect-submodules ptyprocess)
if [ "$(ft_os)" = windows ] && [ "${FORMAT_ENGINE_WINDOWED:-1}" != 0 ]; then optional+=(--noconsole); fi
rm -rf build/pyinstaller dist-engine
"$py" -m PyInstaller --noconfirm --clean --onefile --name format-engine \
  --distpath dist-engine --workpath build/pyinstaller --specpath build/pyinstaller --paths "$FORMAT_ROOT/backend" \
  --add-data "$FORMAT_ROOT/frontend/dist:frontend_dist" --add-data "$FORMAT_ROOT/backend/app/demos:app/demos" \
  --collect-submodules app --collect-submodules uvicorn --collect-submodules websockets --collect-submodules anthropic \
  --collect-submodules mcp.server --collect-submodules mcp.client --collect-submodules mcp.shared --hidden-import mcp.types --exclude-module mcp.cli --collect-data certifi --collect-data docx --collect-data pptx --collect-submodules reportlab --collect-submodules openpyxl \
  --hidden-import segno --hidden-import multipart --hidden-import python_multipart --collect-submodules keyring --copy-metadata keyring \
  "${optional[@]}" \
  --exclude-module tkinter \
  "$FORMAT_ROOT/backend/format_engine.py"
FORMAT_DATA_DIR="$(mktemp -d)" "dist-engine/format-engine" --selfcheck || ft_die "the frozen engine failed its selfcheck; nothing was copied to src-tauri/binaries"
mkdir -p "$FORMAT_ROOT/src-tauri/binaries"
out="$FORMAT_ROOT/src-tauri/binaries/format-engine-${triple}"
cp "dist-engine/format-engine" "$out"
ft_say "sidecar ready: $out ($(du -h "$out" | cut -f1))"
