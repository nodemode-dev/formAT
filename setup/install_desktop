#!/usr/bin/env bash
set -e
source "$(dirname "$0")/lib.sh"
py="$(ft_venv_python)"
ft_say "installing PyInstaller, the built-in browser package and local dictation into the engine venv"
"$py" -m pip install -r "$FORMAT_ROOT/backend/requirements_desktop.txt"
if ! command -v cargo >/dev/null 2>&1; then
  ft_say "Rust is not installed. Install it from https://rustup.rs then run ./format install-desktop again"
  exit 1
fi
if [ "$(ft_os)" = linux ] && ! pkg-config --exists webkit2gtk-4.1 2>/dev/null; then
  ft_say "Tauri needs system libraries. On Debian or Ubuntu run:"
  ft_say "sudo apt install libwebkit2gtk-4.1-dev build-essential curl wget file libxdo-dev libssl-dev libayatana-appindicator3-dev librsvg2-dev patchelf"
  exit 1
fi
[ -x "$FORMAT_ROOT/frontend/node_modules/.bin/tauri" ] || ( cd "$FORMAT_ROOT/frontend" && npm install )
ft_say "desktop toolchain ready: rustc $(rustc --version | awk '{print $2}'), tauri $("$FORMAT_ROOT/frontend/node_modules/.bin/tauri" --version | awk '{print $2}')"
