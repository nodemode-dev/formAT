#!/usr/bin/env bash
set -e
source "$(dirname "$0")/lib.sh"
cd "$FORMAT_ROOT"
for p in frontend/dist backend/build backend/dist-engine native/format-render/target; do rm -rf "$p"; done
find backend -name __pycache__ -type d -prune -exec rm -rf {} + 2>/dev/null || true
if [ "${1:-}" = "--all" ]; then for p in frontend/node_modules backend/venv; do rm -rf "$p"; done; fi
ft_say "clean"
