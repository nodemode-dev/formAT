{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FormAT",
  "mainBinaryName": "format",
  "version": "0.30.1",
  "identifier": "ai.nodemode.format",
  "build": {
    "frontendDist": "../frontend/dist"
  },
  "app": {
    "windows": [
      {
        "label": "splash",
        "title": "FormAT",
        "url": "splash.html",
        "width": 360,
        "height": 200,
        "resizable": false,
        "decorations": false,
        "center": true,
        "transparent": true,
        "shadow": false,
        "visible": false
      }
    ],
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "shortDescription": "A.T, the Agentic Terminal",
    "longDescription": "FormAT is a chat and agent workspace on the Claude API: chats, tools with approvals, artifacts, documents and slides, projects, memory, skills, plugins, connectors, a built-in browser, scheduled tasks and real terminals, on your own API key.",
    "copyright": "Copyright 2026 nodemode-ai.",
    "externalBin": ["binaries/format-engine"],
    "resources": { "../LICENSE": "LICENSE", "../NOTICE.md": "NOTICE.md" },
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "macOS": {
      "minimumSystemVersion": "12.0",
      "hardenedRuntime": true,
      "entitlements": "entitlements.plist"
    },
    "linux": {
      "deb": { "section": "devel", "recommends": ["gstreamer1.0-plugins-base", "gstreamer1.0-plugins-good", "gstreamer1.0-libav"] },
      "rpm": { "recommends": ["gstreamer1-plugins-base", "gstreamer1-plugins-good"] },
      "appimage": { "bundleMediaFramework": true }
    },
    "createUpdaterArtifacts": false
  },
  "plugins": {
    "updater": {
      "pubkey": "",
      "endpoints": ["https://github.com/nodemode-dev/formcompiler/releases/download/format-updates/latest.json"]
    }
  }
}
