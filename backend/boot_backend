#!/usr/bin/env bash
set -e
cd "$(dirname "$0")"
[ -f venv/bin/activate ] || { echo "[format] engine venv missing, run ./format install" >&2; exit 1; }
# shellcheck disable=SC1091
source venv/bin/activate
exec uvicorn app.main:app --reload --reload-dir app --host 127.0.0.1 --port "${FORMAT_PORT:-8490}"
